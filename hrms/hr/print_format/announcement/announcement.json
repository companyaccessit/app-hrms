 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n    .announcement-print {\r\n        font-family: \"Helvetica Neue\", Arial, sans-serif;\r\n        color: #1a1a1a;\r\n        line-height: 1.5;\r\n    }\r\n\r\n    /* ---- Header ---- */\r\n    .ann-header {\r\n        display: table;\r\n        width: 100%;\r\n        border-bottom: 3px solid #2c3e50;\r\n        padding-bottom: 14px;\r\n        margin-bottom: 20px;\r\n    }\r\n    .ann-header-logo {\r\n        display: table-cell;\r\n        width: 80px;\r\n        vertical-align: middle;\r\n    }\r\n    .ann-header-logo img {\r\n        max-width: 70px;\r\n        max-height: 70px;\r\n    }\r\n    .ann-header-text {\r\n        display: table-cell;\r\n        vertical-align: middle;\r\n        text-align: center;\r\n    }\r\n    .ann-header-text h1 {\r\n        font-size: 20px;\r\n        letter-spacing: 1px;\r\n        text-transform: uppercase;\r\n        margin: 0;\r\n        color: #2c3e50;\r\n    }\r\n    .ann-header-text .company-name {\r\n        font-size: 14px;\r\n        font-weight: 600;\r\n        color: #333;\r\n        margin-top: 4px;\r\n    }\r\n    .ann-header-text .company-address {\r\n        font-size: 11px;\r\n        color: #777;\r\n        margin-top: 2px;\r\n    }\r\n    .ann-header-spacer {\r\n        display: table-cell;\r\n        width: 80px;\r\n    }\r\n\r\n    /* ---- Meta table: 2-column, no borders ---- */\r\n    table.ann-meta-table {\r\n        width: 100% !important;\r\n        border-collapse: collapse !important;\r\n        margin: 0 0 18px 0 !important;\r\n        font-size: 12.5px;\r\n    }\r\n    table.ann-meta-table td {\r\n        padding: 5px 8px !important;\r\n        border: none !important;\r\n        margin: 0 !important;\r\n        box-shadow: none !important;\r\n        background: transparent !important;\r\n        vertical-align: middle;\r\n    }\r\n    table.ann-meta-table td.label {\r\n        font-weight: 600 !important;\r\n        color: #555;\r\n        width: 130px;\r\n        white-space: nowrap;\r\n    }\r\n    table.ann-meta-table td.value {\r\n        color: #1a1a1a;\r\n    }\r\n\r\n    .ann-title {\r\n        font-size: 18px;\r\n        font-weight: 700;\r\n        text-align: center;\r\n        margin: 20px 0 6px 0;\r\n        color: #1a1a1a;\r\n    }\r\n    .ann-memo {\r\n        text-align: center;\r\n        font-style: italic;\r\n        color: #555;\r\n        margin-bottom: 16px;\r\n        font-size: 13px;\r\n    }\r\n    .ann-content {\r\n        font-size: 13px;\r\n        margin: 16px 0 28px 0;\r\n        text-align: justify;\r\n        min-height: 100px;\r\n    }\r\n    .ann-status-badge {\r\n        display: inline-block;\r\n        padding: 3px 12px;\r\n        border-radius: 12px;\r\n        font-size: 11px;\r\n        font-weight: 600;\r\n    }\r\n    .badge-draft     { background: #fde2e2; color: #c0392b; }\r\n    .badge-review    { background: #fdf2d9; color: #b8860b; }\r\n    .badge-approved  { background: #d9f2e3; color: #1e7e34; }\r\n    .badge-cancelled { background: #e8e8e8; color: #666; }\r\n\r\n    .ann-sign-section {\r\n        margin-top: 30px;\r\n        border-top: 1px solid #ccc;\r\n        padding-top: 14px;\r\n    }\r\n    .ann-sign-section h3 {\r\n        font-size: 13px;\r\n        text-transform: uppercase;\r\n        color: #2c3e50;\r\n        margin-bottom: 12px;\r\n        letter-spacing: 0.5px;\r\n    }\r\n    .sign-grid {\r\n        display: table;\r\n        width: 100%;\r\n        table-layout: fixed;\r\n        border-collapse: separate;\r\n        border-spacing: 10px;\r\n    }\r\n    .sign-row { display: table-row; }\r\n    .sign-cell {\r\n        display: table-cell;\r\n        width: 25%;\r\n        text-align: center;\r\n        vertical-align: top;\r\n        padding: 6px;\r\n    }\r\n    .sign-box {\r\n        border: 1px solid #ddd;\r\n        border-radius: 4px;\r\n        height: 70px;\r\n        display: flex;\r\n        align-items: center;\r\n        justify-content: center;\r\n        margin-bottom: 6px;\r\n        background: #fafafa;\r\n    }\r\n    .sign-box img { max-height: 60px; max-width: 90%; }\r\n    .sign-label { font-size: 10.5px; font-weight: 600; color: #444; }\r\n\r\n    .ann-final-sign { margin-top: 24px; display: table; width: 100%; }\r\n    .ann-final-sign .sign-cell { width: 50%; }\r\n    .ann-final-sign .sign-box { height: 90px; background: #fff; }\r\n\r\n    .ref-footer {\r\n        margin-top: 20px;\r\n        font-size: 10px;\r\n        color: #999;\r\n        text-align: right;\r\n    }\r\n</style>\r\n\r\n{% set company_doc = frappe.get_doc(\"Company\", doc.company) if doc.company else None %}\r\n{% set addr_links = frappe.get_all(\"Dynamic Link\", filters={\"link_doctype\": \"Company\", \"link_name\": doc.company, \"parenttype\": \"Address\"}, fields=[\"parent\"], limit=1) if doc.company else [] %}\r\n{% set company_address = frappe.get_doc(\"Address\", addr_links[0].parent) if addr_links else None %}\r\n\r\n<div class=\"announcement-print\">\r\n\r\n    <div class=\"ann-header\">\r\n        <div class=\"ann-header-logo\">\r\n            {% if company_doc and company_doc.company_logo %}\r\n                <img src=\"{{ company_doc.company_logo }}\">\r\n            {% endif %}\r\n        </div>\r\n        <div class=\"ann-header-text\">\r\n            <h1>Company Announcement</h1>\r\n            {% if company_doc %}\r\n                {{ company_doc.company_name or doc.company }}\r\n            {% else %}\r\n                All Company\r\n            {% endif %}\r\n            {% if company_address %}\r\n            <div class=\"company-address\">\r\n                {{ company_address.address_line1 or \"\" }}{% if company_address.address_line2 %}, {{ company_address.address_line2 }}{% endif %}{% if company_address.city %}, {{ company_address.city }}{% endif %}{% if company_address.state %}, {{ company_address.state }}{% endif %}{% if company_address.country %}, {{ company_address.country }}{% endif %}\r\n            </div>\r\n            {% endif %}\r\n        </div>\r\n        <div class=\"ann-header-spacer\"></div>\r\n    </div>\r\n\r\n    <table class=\"ann-meta-table\">\r\n        <tr>\r\n            <td class=\"label\">Reference</td>\r\n            <td class=\"value\">{{ doc.reference or \"\u2014\" }}</td>\r\n            <td class=\"label\">Posting Date</td>\r\n            <td class=\"value\">{{ frappe.utils.formatdate(doc.posting_date) if doc.posting_date else \"\u2014\" }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"label\">Announced By</td>\r\n            <td class=\"value\">{{ doc.employee_name or doc.announcement_by or \"\u2014\" }}</td>\r\n            <td class=\"label\">Department</td>\r\n            <td class=\"value\">{{ doc.department or \"\u2014\" }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"label\">Period Start</td>\r\n            <td class=\"value\">{{ frappe.utils.formatdate(doc.start_date) if doc.start_date else \"\u2014\" }}</td>\r\n            <td class=\"label\">Period End</td>\r\n            <td class=\"value\">{{ frappe.utils.formatdate(doc.end_date) if doc.end_date else \"\u2014\" }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"label\">Status</td>\r\n            <td class=\"value\" colspan=\"3\">\r\n                {% if doc.docstatus == 0 %}\r\n                    <span class=\"ann-status-badge badge-draft\">Draft</span>\r\n                {% elif doc.docstatus == 1 and doc.is_approved %}\r\n                    <span class=\"ann-status-badge badge-approved\">\u2713 Approved on {{ frappe.utils.formatdate(doc.approved_date) }}</span>\r\n                {% elif doc.docstatus == 1 and not doc.is_approved %}\r\n                    <span class=\"ann-status-badge badge-review\">Review</span>\r\n                {% elif doc.docstatus == 2 %}\r\n                    <span class=\"ann-status-badge badge-cancelled\">Cancelled</span>\r\n                {% endif %}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <div class=\"ann-title\">{{ doc.title }}</div>\r\n    {% if doc.memo %}\r\n    <div class=\"ann-memo\">{{ doc.memo }}</div>\r\n    {% endif %}\r\n\r\n    <div class=\"ann-content\">\r\n        {{ doc.content or \"\" }}\r\n    </div>\r\n\r\n    <div class=\"ann-sign-section\">\r\n        <h3>Department Approvals</h3>\r\n        <div class=\"sign-grid\">\r\n            <div class=\"sign-row\">\r\n                <div class=\"sign-cell\">\r\n                    <div class=\"sign-box\">{% if doc.department_of_human_resource %}<img src=\"{{ doc.department_of_human_resource }}\">{% endif %}</div>\r\n                    <div class=\"sign-label\">Department of Human Resource</div>\r\n                </div>\r\n                <div class=\"sign-cell\">\r\n                    <div class=\"sign-box\">{% if doc.department_of_finance %}<img src=\"{{ doc.department_of_finance }}\">{% endif %}</div>\r\n                    <div class=\"sign-label\">Department of Accounting & Finance</div>\r\n                </div>\r\n                <div class=\"sign-cell\">\r\n                    <div class=\"sign-box\">{% if doc.procurement_purchasing %}<img src=\"{{ doc.procurement_purchasing }}\">{% endif %}</div>\r\n                    <div class=\"sign-label\">Department of Procurement & Purchasing</div>\r\n                </div>\r\n                <div class=\"sign-cell\">\r\n                    <div class=\"sign-box\">{% if doc.department_of_sale_execution %}<img src=\"{{ doc.department_of_sale_execution }}\">{% endif %}</div>\r\n                    <div class=\"sign-label\">Department of Sale Execution</div>\r\n                </div>\r\n            </div>\r\n            <div class=\"sign-row\">\r\n                <div class=\"sign-cell\">\r\n                    <div class=\"sign-box\">{% if doc.promotion_scheming %}<img src=\"{{ doc.promotion_scheming }}\">{% endif %}</div>\r\n                    <div class=\"sign-label\">Department of Promotion & Scheming</div>\r\n                </div>\r\n                <div class=\"sign-cell\">\r\n                    <div class=\"sign-box\">{% if doc.transport_logistic %}<img src=\"{{ doc.transport_logistic }}\">{% endif %}</div>\r\n                    <div class=\"sign-label\">Department of Transport & Logistic</div>\r\n                </div>\r\n                <div class=\"sign-cell\">\r\n                    <div class=\"sign-box\">{% if doc.business_legal %}<img src=\"{{ doc.business_legal }}\">{% endif %}</div>\r\n                    <div class=\"sign-label\">Department of Business & Legal</div>\r\n                </div>\r\n                <div class=\"sign-cell\">\r\n                    <div class=\"sign-box\">{% if doc.ai_technology %}<img src=\"{{ doc.ai_technology }}\">{% endif %}</div>\r\n                    <div class=\"sign-label\">Department of AI & Technology</div>\r\n                </div>\r\n            </div>\r\n            <div class=\"sign-row\">\r\n                <div class=\"sign-cell\">\r\n                    <div class=\"sign-box\">{% if doc.food %}<img src=\"{{ doc.food }}\">{% endif %}</div>\r\n                    <div class=\"sign-label\">Department of Food</div>\r\n                </div>\r\n                <div class=\"sign-cell\">\r\n                    <div class=\"sign-box\">{% if doc.beverage %}<img src=\"{{ doc.beverage }}\">{% endif %}</div>\r\n                    <div class=\"sign-label\">Department of Beverage</div>\r\n                </div>\r\n                <div class=\"sign-cell\">\r\n                    <div class=\"sign-box\">{% if doc.cafe %}<img src=\"{{ doc.cafe }}\">{% endif %}</div>\r\n                    <div class=\"sign-label\">Department of Cafe</div>\r\n                </div>\r\n                <div class=\"sign-cell\">\r\n                    <div class=\"sign-box\">{% if doc.media_digital_marketing %}<img src=\"{{ doc.media_digital_marketing }}\">{% endif %}</div>\r\n                    <div class=\"sign-label\">Department of Media & Digital Marketing</div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"ann-sign-section ann-final-sign\">\r\n        <div class=\"sign-row\">\r\n            <div class=\"sign-cell\">\r\n                <div class=\"sign-box\">{% if doc.general_manager %}<img src=\"{{ doc.general_manager }}\">{% endif %}</div>\r\n                <div class=\"sign-label\">General Manager</div>\r\n            </div>\r\n            <div class=\"sign-cell\">\r\n                <div class=\"sign-box\">{% if doc.managing_director %}<img src=\"{{ doc.managing_director }}\">{% endif %}</div>\r\n                <div class=\"sign-label\">Managing Director</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"ref-footer\">\r\n        Document: {{ doc.name }} {% if doc.amended_from %}(Amended from {{ doc.amended_from }}){% endif %}\r\n    </div>\r\n\r\n</div>",
